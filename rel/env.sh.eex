#!/bin/sh
# Timeless Metrics BEAM tuning — scales from embedded (1 core, 2GB) to server (192 cores, 1.5TB)

export RELEASE_DISTRIBUTION=none

case "$(uname -s)" in
  Darwin)
    CORES=$(sysctl -n hw.ncpu)
    RAM_MB=$(( $(sysctl -n hw.memsize) / 1024 / 1024 ))
    ;;
  *)
    CORES=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
    RAM_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
    ;;
esac

CORES="${TIMELESS_CORES:-$CORES}"
RAM_MB="${TIMELESS_RAM_MB:-$RAM_MB}"

# Scheduler: aggressive wakeup, no compaction, bind on Linux
SCHED_FLAGS="+swt very_low +scl false +SDcpu $CORES"
if [ "$CORES" -gt 1 ] && [ "$(uname -s)" != "Darwin" ]; then
  SCHED_FLAGS="$SCHED_FLAGS +sbt ps"
fi

# Async I/O threads (SQLite): 2x cores, [4, 128]
ASYNC=$(( CORES * 2 ))
[ "$ASYNC" -lt 4 ] && ASYNC=4
[ "$ASYNC" -gt 128 ] && ASYNC=128

# Heap sizing: trade RAM for fewer GCs on bigger machines
if [ "$RAM_MB" -gt 8192 ]; then
  HEAP_FLAGS="+hms 1024 +hmbs 1024"
elif [ "$RAM_MB" -gt 2048 ]; then
  HEAP_FLAGS="+hms 512 +hmbs 512"
else
  HEAP_FLAGS=""
fi

# Allocator tuning: 32GB+ gets AOBF, 128GB+ gets large carriers
ALLOC_FLAGS=""
if [ "$RAM_MB" -gt 32768 ]; then
  ALLOC_FLAGS="+MBas aobf +MEas aobf"
  if [ "$RAM_MB" -gt 131072 ]; then
    ALLOC_FLAGS="$ALLOC_FLAGS +MBlmbcs 512 +MElmbcs 512"
  else
    ALLOC_FLAGS="$ALLOC_FLAGS +MBlmbcs 256 +MElmbcs 256"
  fi
fi

# Super carrier: 256GB+ pre-allocates 60% as contiguous block
SC_FLAGS=""
if [ "$RAM_MB" -gt 262144 ]; then
  SC_SIZE=$(( RAM_MB * 60 / 100 ))
  SC_FLAGS="+MMscs $SC_SIZE"
fi

# Process/port limits for high core counts
LIMIT_FLAGS=""
if [ "$CORES" -gt 64 ]; then
  LIMIT_FLAGS="+P 5000000 +Q 1048576"
elif [ "$CORES" -gt 16 ]; then
  LIMIT_FLAGS="+P 2000000 +Q 524288"
fi

export ERL_FLAGS="$SCHED_FLAGS +A $ASYNC $HEAP_FLAGS $ALLOC_FLAGS $SC_FLAGS $LIMIT_FLAGS"
